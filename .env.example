# Compose host binding
API_HOST=0.0.0.0
API_PORT=8000

# Local MLflow registry and model selection
MLFLOW_TRACKING_URI=sqlite:////app/tracking/mlflow.db
MLFLOW_EXPERIMENT_NAME=test
MODEL_NAME=churn-propensity
MODEL_ALIAS=champion
LOG_LEVEL=INFO
GIT_PYTHON_REFRESH=quiet

# Inference logging and observability
REQUEST_ID_HEADER=X-Request-ID
LOG_FEATURES=True

# Paths inside the application container
ARTIFACT_DIR=/app/artifacts
TRACKING_DIR=/app/tracking
RAW_DATA_DIR=/app/data/raw
CONFIG_DIR=/app/src/config
TMP_DIR=/app/tmp
LOGGING_DIR=/app/logs
